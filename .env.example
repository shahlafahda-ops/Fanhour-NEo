# Copy to .env and set real values. Never commit the filled-in file.

# HMAC key for phone hashing. Generate with: openssl rand -hex 32
# Rotating this orphans every existing fan record — treat it as permanent.
FH_PHONE_PEPPER=change-me

# Guards /api/admin/*
FH_ADMIN_KEY=change-me

# SQLite location
FH_DATA_DIR=./data

# Per-IP requests per minute (0 disables; the edge should also rate limit)
FH_RATE_LIMIT=120

PORT=8787
