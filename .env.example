# =====================================================================
# FanHour — Environment configuration (Al Hazem Pilot 1)
# Copy to .env.local for development. NEVER commit real secrets.
# Every variable below is documented in docs/OPERATIONS.md.
# =====================================================================

# ---- App ----
# Canonical public URL (used for OG tags, share links, OTP redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# App environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ---- Supabase ----
# Public project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# Used exclusively by server code that must bypass RLS (ops/merchant/system).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- OTP provider ----
# Provider: mock | twilio | unifonic
# mock is ONLY permitted when NEXT_PUBLIC_APP_ENV != production.
# Production hard-fails at boot if OTP_PROVIDER=mock.
OTP_PROVIDER=mock
OTP_SENDER_ID=FanHour
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Unifonic (Saudi provider)
UNIFONIC_APP_SID=
UNIFONIC_SENDER=

# ---- Support ----
# Where support tickets are delivered (email or webhook). Optional.
SUPPORT_DESTINATION=

# ---- Legal / compliance ----
# Bumped whenever privacy/terms copy changes; stored on each consent record.
PRIVACY_POLICY_VERSION=2026-08-draft
TERMS_VERSION=2026-08-draft

# ---- Safety guards ----
# Must be false in production. Blocks seed/test data from loading.
ALLOW_TEST_DATA=true
# Community feedback minimum sample before percentages are shown.
COMMUNITY_MIN_SAMPLE=20
# Age required to claim a benefit.
BENEFIT_MIN_AGE=18
# Default prediction cutoff, minutes before kickoff (ops can override per fixture).
DEFAULT_CUTOFF_MINUTES_BEFORE_KICKOFF=5
