# Copy to .env and set real values. Never commit the filled-in file.

# HMAC key for phone hashing. Generate with: openssl rand -hex 32
# Rotating this orphans every existing fan record — treat it as permanent.
FH_PHONE_PEPPER=change-me

# Guards /api/admin/*
FH_ADMIN_KEY=change-me

# SQLite location
FH_DATA_DIR=./data

# Per-IP requests per minute (0 disables; the edge should also rate limit)
FH_RATE_LIMIT=120

PORT=8787

# Guards /api/board and the /board projector screen. Separate from the admin key
# on purpose: a board on a wall should never carry admin access.
FH_BOARD_KEY=change-me

# Demo mode: shows the OTP on the fan's screen so the journey can be filmed
# without a live SMS route. FAILS the launch-readiness gate. Never set to 1
# in production.
FH_DEMO=0
